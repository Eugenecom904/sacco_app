<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Title -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="My Profile"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#1F6B43"
            android:gravity="center"
            android:layout_marginBottom="25dp" />

        <!-- Profile Card -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="20dp"
            android:elevation="4dp">

            <!-- Full Name -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Full Name"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="#777777" />

            <TextView
                android:id="@+id/tvProfileName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Loading..."
                android:textSize="19sp"
                android:textStyle="bold"
                android:textColor="#222222"
                android:layout_marginBottom="18dp" />

            <!-- Member Number -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Member Number"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="#777777" />

            <TextView
                android:id="@+id/tvProfileMemberNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Loading..."
                android:textSize="18sp"
                android:textColor="#222222"
                android:layout_marginBottom="18dp" />

            <!-- Phone -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Phone Number"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="#777777" />

            <TextView
                android:id="@+id/tvProfilePhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Loading..."
                android:textSize="18sp"
                android:textColor="#222222"
                android:layout_marginBottom="18dp" />

            <!-- Email -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Email Address"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="#777777" />

            <TextView
                android:id="@+id/tvProfileEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Loading..."
                android:textSize="18sp"
                android:textColor="#222222"
                android:layout_marginBottom="18dp" />

            <!-- Date of Birth -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Date of Birth"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="#777777" />

            <TextView
                android:id="@+id/tvProfileDob"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Loading..."
                android:textSize="18sp"
                android:textColor="#222222"
                android:layout_marginBottom="18dp" />

            <!-- Registration Date -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Registration Date"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="#777777" />

            <TextView
                android:id="@+id/tvProfileRegistrationDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Loading..."
                android:textSize="18sp"
                android:textColor="#222222" />

        </LinearLayout>

        <!-- Change Password -->

        <Button
            android:id="@+id/btnChangePassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CHANGE PASSWORD"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1F6B43"
            android:layout_marginTop="25dp" />

        <!-- Back -->

        <Button
            android:id="@+id/btnBackProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="BACK"
            android:textStyle="bold"
            android:layout_marginTop="10dp" />

    </LinearLayout>

</ScrollView>