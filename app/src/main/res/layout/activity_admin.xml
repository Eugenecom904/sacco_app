<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7F5">

    ```
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Admin Dashboard"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#1F6B43"
            android:layout_marginBottom="5dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Manage SACCO loan applications"
            android:textSize="15sp"
            android:textColor="#666666"
            android:layout_marginBottom="25dp" />

        <!-- Pending Loans -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pending Loan Applications"
            android:textSize="21sp"
            android:textStyle="bold"
            android:textColor="#222222"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:id="@+id/pendingLoansContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNoPendingLoans"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No pending loan applications."
                android:textSize="16sp"
                android:textColor="#777777"
                android:padding="20dp"
                android:gravity="center" />

        </LinearLayout>

        <Button
            android:id="@+id/btnRefreshLoans"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="REFRESH LOAN APPLICATIONS"
            android:textStyle="bold"
            android:backgroundTint="#1F6B43"
            android:textColor="#FFFFFF"
            android:layout_marginTop="20dp" />

        <Button
            android:id="@+id/btnBack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="BACK"
            android:layout_marginTop="15dp" />

    </LinearLayout>
    ```

</ScrollView>
